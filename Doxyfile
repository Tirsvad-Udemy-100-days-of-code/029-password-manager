# Doxygen configuration for MyPass.
# Build with:  doxygen Doxyfile      (output: docs/doxygen/html/index.html)
# Only the settings that differ from Doxygen's defaults are listed.

PROJECT_NAME           = "MyPass"
PROJECT_BRIEF          = "A small Tkinter password manager (Udemy 100 Days of Code, day 29)"
PROJECT_NUMBER         = 0.1.0
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

# Python source in src/
INPUT                  = src
FILE_PATTERNS          = *.py
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SOURCE_BROWSER         = YES

# Output
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
